{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.codex/hooks/validate-branch-off-main.sh\"",
            "timeout": 30,
            "statusMessage": "Checking branch start ref..."
          }
        ]
      }
    ]
  }
}
