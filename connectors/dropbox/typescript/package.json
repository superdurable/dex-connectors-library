{
  "name": "@superdurable/connector-dropbox",
  "version": "0.2.0",
  "description": "Dropbox file operations for Dex TypeScript Flows",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superdurable/dex-connectors-library.git",
    "directory": "connectors/dropbox/typescript"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js"
    },
    "./dex-connector.json": "./dex-connector.json"
  },
  "files": [
    "dist",
    "dex-connector.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/mock.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test examples",
    "test": "npm run build && vitest run --exclude test/integration.test.ts",
    "test:integration": "npm run build && vitest run test/integration.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "example:worker": "tsx examples/file-lookup/main.ts",
    "example:integration": "tsx examples/file-lookup/integration.ts"
  },
  "dependencies": {
    "@superdurable/connectors-sdk": "0.7.0",
    "@superdurable/dex": ">=1.28.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.1"
  }
}
