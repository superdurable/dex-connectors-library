{
  "connectorId": "datadog",
  "releaseTag": "connectors/datadog/go/v0.3.0",
  "package": {
    "ecosystem": "pypi",
    "name": "dex-connector-datadog",
    "version": "0.2.0"
  },
  "factories": [
    {
      "name": "new_query_metrics_step",
      "kind": "query",
      "operationId": "queryMetrics",
      "inputType": "QueryMetricsInput",
      "description": "Query Datadog timeseries points over an explicit Unix-second interval.",
      "fields": {
        "stepType": "step_type",
        "annotations": "annotations",
        "connectionName": "connection_name",
        "resultAttribute": "result_attribute"
      },
      "branches": [
        {
          "id": "queried",
          "field": "queried",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "provider_rejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalid_response",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "QueryMetricsInput supplies the metric expression and Unix-second window.",
        "properties": {
          "from": {
            "description": "From is the inclusive start in Unix seconds.",
            "type": "integer"
          },
          "query": {
            "description": "Query is a Datadog metric query expression.",
            "type": "string"
          },
          "to": {
            "description": "To is the exclusive end in Unix seconds and must follow From.",
            "type": "integer"
          }
        },
        "required": [
          "from",
          "query",
          "to"
        ],
        "type": "object"
      }
    },
    {
      "name": "new_list_monitors_step",
      "kind": "query",
      "operationId": "listMonitors",
      "inputType": "ListMonitorsInput",
      "description": "List one page of Datadog monitors.",
      "fields": {
        "stepType": "step_type",
        "annotations": "annotations",
        "connectionName": "connection_name",
        "resultAttribute": "result_attribute"
      },
      "branches": [
        {
          "id": "listed",
          "field": "listed",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "provider_rejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalid_response",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "ListMonitorsInput selects a zero-based monitor page.",
        "properties": {
          "page": {
            "description": "Page is zero-based; zero selects the first page.",
            "type": "integer"
          },
          "pageSize": {
            "description": "PageSize is the number of monitors requested; zero selects 100.",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  ]
}
