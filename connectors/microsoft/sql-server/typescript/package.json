{
  "name": "@superdurable/connector-microsoft-sql-server",
  "version": "0.1.0",
  "description": "Microsoft SQL Server query and execute operations for Dex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superdurable/dex-connectors-library.git",
    "directory": "connectors/microsoft/sql-server/typescript"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js"
    }
  },
  "files": [
    "dist",
    "dex-connector.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/mock.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test examples",
    "test": "npm run build && vitest run --exclude 'test/integration.test.ts' --exclude 'test/dex.integration.test.ts'",
    "test:integration": "npm run build && vitest run test/integration.test.ts",
    "check": "npm test && npm run typecheck && npm run lint",
    "example:query": "npm run build && tsx examples/query-rows/main.ts",
    "example:query:start": "npm run build && tsx examples/query-rows/start.ts",
    "example:execute": "npm run build && tsx examples/record-refund/main.ts",
    "example:execute:start": "npm run build && tsx examples/record-refund/start.ts",
    "test:dex-integration": "npm run build && vitest run test/dex.integration.test.ts"
  },
  "dependencies": {
    "@superdurable/connectors-sdk": "0.1.0",
    "@superdurable/dex": ">=1.28.0",
    "mssql": "^12.7.13",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/mssql": "^9.1.8",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tedious": "^20.3.8",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.1"
  }
}
