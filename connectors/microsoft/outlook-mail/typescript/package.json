{
  "name": "@superdurable/connector-microsoft-outlook-mail",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Microsoft Outlook Mail connector for Dex TypeScript applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superdurable/dex-connectors-library.git",
    "directory": "connectors/microsoft/outlook-mail/typescript"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mock": {
      "import": {
        "types": "./dist/mock/index.d.ts",
        "default": "./dist/mock/index.js"
      },
      "require": {
        "types": "./dist/mock/index.d.cts",
        "default": "./dist/mock/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "dex-connector.json"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsup src/index.ts src/mock/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test examples",
    "test": "vitest run test/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "example:worker": "tsx examples/read-message/main.ts",
    "example:start": "tsx examples/read-message/start.ts",
    "test:integration": "vitest run examples/read-message/integration.test.ts"
  },
  "dependencies": {
    "@superdurable/connectors-sdk": "0.7.0",
    "@superdurable/dex": ">=1.28.0",
    "htmlparser2": "^10.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.1"
  }
}
