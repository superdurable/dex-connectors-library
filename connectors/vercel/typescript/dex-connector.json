{
  "connectorId": "vercel",
  "releaseTag": "connectors/vercel/go/v0.2.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-vercel",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newListDeploymentsStep",
      "kind": "query",
      "operationId": "listDeployments",
      "inputType": "ListDeploymentsInput",
      "description": "List deployments visible to a personal account or team.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "listed",
          "field": "listed",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "ListDeploymentsInput optionally selects a Vercel team ID.",
        "properties": {
          "teamId": {
            "description": "TeamID is the team ID; blank uses the personal account.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "newGetDeploymentStep",
      "kind": "query",
      "operationId": "getDeployment",
      "inputType": "GetDeploymentInput",
      "description": "Read a deployment by Vercel deployment ID or hostname.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "notFound",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GetDeploymentInput identifies one deployment and an optional team.",
        "properties": {
          "idOrUrl": {
            "description": "IDOrURL is a deployment ID or hostname.",
            "type": "string"
          },
          "teamId": {
            "description": "TeamID is the team ID; blank uses the personal account.",
            "type": "string"
          }
        },
        "required": [
          "idOrUrl"
        ],
        "type": "object"
      }
    }
  ]
}
