  "package": {
    "ecosystem": "pypi",
    "name": "dex-connector-openweathermap",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "new_get_current_weather_step",
      "kind": "query",
      "operationId": "getCurrentWeather",
      "inputType": "WeatherInput",
      "description": "Read current temperature and weather conditions at geographic coordinates.",
      "fields": {
        "stepType": "step_type",
        "annotations": "annotations",
        "connectionName": "connection_name",
        "resultAttribute": "result_attribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "not_found",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "provider_rejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalid_response",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "WeatherInput selects coordinates and temperature units.",
        "properties": {
          "latitude": {
            "description": "Latitude is degrees north, from -90 through 90.",
            "type": "number"
          },
          "longitude": {
            "description": "Longitude is degrees east, from -180 through 180.",
            "type": "number"
          },
          "units": {
            "description": "Units is standard, metric, or imperial; blank uses standard.",
            "type": "string"
          }
        },
        "required": [
          "latitude",
          "longitude"
        ],
        "type": "object"
      }
    },
