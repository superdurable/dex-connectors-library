{
  "connectorId": "hacker-news-daily",
  "releaseTag": "connectors/hackernews/go/v0.27.0",
  "package": {
    "ecosystem": "cargo",
    "name": "dex-connector-hackernews",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "new_list_story_ids_step",
      "kind": "query",
      "operationId": "listStoryIDs",
      "inputType": "ListStoryIDsInput",
      "description": "List current Hacker News story IDs in feed order. Choose feed top, best, new, ask (Ask HN), or show (Show HN), and limit from 1 to 500. Read each returned ID as a Hacker News item for its title and links.",
      "agent": {
        "exposed": true,
        "branches": {
          "defect": "rejected",
          "providerRejected": "rejected"
        }
      },
      "fields": {
        "stepType": "step_type",
        "annotations": "annotations",
        "connectionName": "connection_name",
        "resultAttribute": "result_attribute"
      },
      "branches": [
        {
          "id": "listed",
          "field": "listed",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "provider_rejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalid_response",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "ListStoryIDsInput selects one feed snapshot. It does not select a historical time window.",
        "properties": {
          "feed": {
            "description": "Feed is top, best, new, ask, or show. Empty selects top.",
            "type": "string"
          },
          "limit": {
            "description": "Limit bounds returned IDs from 1 through 500. Zero selects 50.",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  ]
}
