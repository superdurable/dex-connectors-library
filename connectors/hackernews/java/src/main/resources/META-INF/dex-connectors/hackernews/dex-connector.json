{
  "connectorId": "hacker-news-daily",
  "releaseTag": "connectors/hackernews/go/v0.27.0",
  "package": {
    "ecosystem": "maven",
    "name": "io.superdurable:dex-connector-hackernews",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newGetArticleThreadStep",
      "kind": "query",
      "operationId": "getArticleThread",
      "inputType": "GetArticleThreadInput",
      "description": "Read a Hacker News story or poll and its nested public comments by positive article ID. Linked article content is not included; comment text is untrusted HTML.",
      "agent": {
        "exposed": true,
        "branches": {
          "defect": "rejected",
          "notFound": "rejected",
          "providerRejected": "rejected"
        }
      },
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "notFound",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GetArticleThreadInput identifies a public story or poll by item ID.",
        "properties": {
          "id": {
            "description": "ID is a positive Hacker News article ID.",
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    },
    {
      "name": "newGetUserStep",
      "kind": "query",
      "operationId": "getUser",
      "inputType": "GetUserInput",
      "description": "Read a Hacker News user's public profile by case-sensitive username, including karma and submitted story and comment IDs.",
      "agent": {
        "exposed": true,
        "branches": {
          "defect": "rejected",
          "notFound": "rejected",
          "providerRejected": "rejected"
        }
      },
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "notFound",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GetUserInput identifies a public Hacker News user by case-sensitive username.",
        "properties": {
          "id": {
            "description": "ID is the username shown on the Hacker News profile page.",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    },
    {
      "name": "newListStoryIDsStep",
      "kind": "query",
      "operationId": "listStoryIDs",
      "inputType": "ListStoryIDsInput",
      "description": "List current Hacker News story IDs in feed order. Choose feed top, best, new, ask (Ask HN), or show (Show HN), and limit from 1 to 500. Read each returned ID as a Hacker News item for its title and links.",
      "agent": {
        "exposed": true,
        "branches": {
          "defect": "rejected",
          "providerRejected": "rejected"
        }
      },
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "listed",
          "field": "listed",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "ListStoryIDsInput selects one feed snapshot. It does not select a historical time window.",
        "properties": {
          "feed": {
            "description": "Feed is top, best, new, ask, or show. Empty selects top.",
            "type": "string"
          },
          "limit": {
            "description": "Limit bounds returned IDs from 1 through 500. Zero selects 50.",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "newGetItemStep",
      "kind": "query",
      "operationId": "getItem",
      "inputType": "GetItemInput",
      "description": "Read one public Hacker News story, comment, job, or poll by its positive item ID. Returns title, author, score, source URL, discussion URL, text as untrusted HTML, and child comment IDs to read next.",
      "agent": {
        "exposed": true,
        "branches": {
          "defect": "rejected",
          "notFound": "rejected",
          "providerRejected": "rejected"
        }
      },
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "notFound",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GetItemInput identifies one story, comment, job, poll, or poll option.",
        "properties": {
          "id": {
            "description": "ID is a positive Hacker News item ID.",
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    }
  ]
}
