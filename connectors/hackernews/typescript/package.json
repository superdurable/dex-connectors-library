{
  "name": "@superdurable/connector-hackernews",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Hacker News connector for Dex TypeScript applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superdurable/dex-connectors-library.git",
    "directory": "connectors/hackernews/typescript"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hackernewsmock": {
      "types": "./dist/hackernewsmock.d.ts",
      "import": "./dist/hackernewsmock.js"
    },
    "./dex-connector.json": "./dex-connector.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "dex-connector.json"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsup src/index.ts src/hackernewsmock.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test examples",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "example:top-story": "tsx examples/top-story/worker.ts",
    "integration:top-story": "tsx examples/top-story/integration.ts"
  },
  "dependencies": {
    "@superdurable/connectors-sdk": "0.8.0",
    "@superdurable/dex": ">=1.28.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.1"
  }
}
