{
  "connectorId": "hacker-news-daily",
  "releaseTag": "connectors/hackernews/go/v0.23.0",
  "package": {
    "ecosystem": "pypi",
    "name": "dex-connector-hackernews",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "new_list_story_ids_step",
      "kind": "query",
      "operationId": "listStoryIDs",
      "inputType": "ListStoryIDsInput",
      "description": "Read a bounded snapshot of the top, best, new, Ask HN, or Show HN feed in provider order.",
      "fields": {
        "stepType": "step_type",
        "annotations": "annotations",
        "connectionName": "connection_name",
        "resultAttribute": "result_attribute"
      },
      "branches": [
        {
          "id": "listed",
          "field": "listed",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "provider_rejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalid_response",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "ListStoryIDsInput selects one feed snapshot. It does not select a historical time window.",
        "properties": {
          "feed": {
            "description": "Feed is top, best, new, ask, or show. Empty selects top.",
            "type": "string"
          },
          "limit": {
            "description": "Limit bounds returned IDs from 1 through 500. Zero selects 50.",
            "type": "integer"
          }
        },
        "required": [
          "feed",
          "limit"
        ],
        "type": "object"
      }
    },
    {
      "name": "new_get_item_step",
      "kind": "query",
      "operationId": "getItem",
      "inputType": "GetItemInput",
      "description": "Read one public story or comment, its child IDs, and its direct Hacker News link.",
      "fields": {
        "stepType": "step_type",
        "annotations": "annotations",
        "connectionName": "connection_name",
        "resultAttribute": "result_attribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "not_found",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "provider_rejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalid_response",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GetItemInput identifies one story, comment, job, poll, or poll option.",
        "properties": {
          "id": {
            "description": "ID is a positive Hacker News item ID.",
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    }
  ]
}
