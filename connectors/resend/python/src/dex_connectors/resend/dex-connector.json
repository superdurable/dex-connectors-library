{
  "connectorId": "resend",
  "releaseTag": "connectors/resend/go/v0.2.0",
  "package": {
    "ecosystem": "pypi",
    "name": "dex-connector-resend",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "new_send_email_step",
      "kind": "mutation",
      "operationId": "sendEmail",
      "inputType": "SendEmailInput",
      "description": "SendEmail through the Resend public JSON API.",
      "fields": {
        "stepType": "step_type",
        "annotations": "annotations",
        "connectionName": "connection_name",
        "resultAttribute": "result_attribute"
      },
      "branches": [
        {
          "id": "sent",
          "field": "sent",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "provider_rejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalid_response",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "SendEmailInput is the exact payload sent once per keyed email operation.",
        "properties": {
          "from": {
            "description": "From is the verified sender email address.",
            "type": "string"
          },
          "html": {
            "description": "HTML is the HTML email body.",
            "type": "string"
          },
          "subject": {
            "description": "Subject is the email subject.",
            "type": "string"
          },
          "to": {
            "description": "To contains recipient email addresses.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "from",
          "html",
          "subject",
          "to"
        ],
        "type": "object"
      }
    },
    {
      "name": "new_get_email_step",
      "kind": "query",
      "operationId": "getEmail",
      "inputType": "GetEmailInput",
      "description": "GetEmail through the Resend public JSON API.",
      "fields": {
        "stepType": "step_type",
        "annotations": "annotations",
        "connectionName": "connection_name",
        "resultAttribute": "result_attribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "not_found",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "provider_rejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalid_response",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GetEmailInput identifies one sent email.",
        "properties": {
          "id": {
            "description": "ID is the provider's stable resource identifier.",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    }
  ]
