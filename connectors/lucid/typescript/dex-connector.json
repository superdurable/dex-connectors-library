{
  "connectorId": "lucid",
  "releaseTag": "connectors/lucid/go/v0.1.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-lucid",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newListDocumentsStep",
      "kind": "query",
      "operationId": "listDocuments",
      "inputType": "ListDocumentsInput",
      "description": "Search one page of accessible, non-trashed Lucid documents and return IDs and titles only.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "listed",
          "field": "listed",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "ListDocumentsInput selects a page by its opaque, non-secret token.",
        "properties": {
          "pageToken": {
            "description": "PageToken is blank for the first page or a previous NextPageToken value.",
            "type": "string"
          }
        },
        "required": [
          "pageToken"
        ],
        "type": "object"
      }
    }
  ]
}
