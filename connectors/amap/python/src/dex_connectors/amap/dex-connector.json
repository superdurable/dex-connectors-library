{
  "connectorId": "amap",
  "releaseTag": "connectors/amap/go/v0.1.0",
  "package": {
    "ecosystem": "pypi",
    "name": "dex-connector-amap",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "new_geocode_address_step",
      "kind": "query",
      "operationId": "geocodeAddress",
      "inputType": "GeocodeAddressInput",
      "description": "Resolve one structured Chinese address to Amap's candidate locations, optionally limiting the search to a city.",
      "fields": {
        "stepType": "step_type",
        "annotations": "annotations",
        "connectionName": "connection_name",
        "resultAttribute": "result_attribute"
      },
      "branches": [
        {
          "id": "geocoded",
          "field": "geocoded",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "provider_rejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalid_response",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GeocodeAddressInput selects a structured address and optional city scope.",
        "properties": {
          "address": {
            "description": "Address is the Chinese address, from province to street number.",
            "type": "string"
          },
          "city": {
            "description": "City optionally limits matching to a Chinese city name, pinyin, citycode, or adcode.",
            "type": "string"
          }
        },
        "required": [
          "address"
        ],
        "type": "object"
      }
    }
  ]
}
