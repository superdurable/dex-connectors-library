{
  "connectorId": "brevo",
  "releaseTag": "connectors/brevo/go/v0.2.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-brevo",
    "version": "0.1.1"
  },
  "factories": [
    {
      "name": "newCreateOrUpdateContactStep",
      "kind": "mutation",
      "operationId": "createOrUpdateContact",
      "inputType": "CreateOrUpdateContactInput",
      "description": "Create a contact by email or set its specified attributes when it already exists.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "saved",
          "field": "saved",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "CreateOrUpdateContactInput supplies an email and absolute attribute values.",
        "properties": {
          "attributes": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Attributes sets existing Brevo contact attributes by their uppercase names.",
            "type": "object"
          },
          "email": {
            "description": "Email identifies the contact and must be a plain email address.",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      }
    },
    {
      "name": "newGetContactStep",
      "kind": "query",
      "operationId": "getContact",
      "inputType": "GetContactInput",
      "description": "Get a Brevo contact by email address.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "notFound",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GetContactInput identifies a contact by email.",
        "properties": {
          "email": {
            "description": "Email is a plain email address.",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      }
    }
  ]
}
