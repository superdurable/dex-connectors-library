{
  "connectorId": "bmob",
  "releaseTag": "connectors/bmob/go/v0.1.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-bmob",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newCountClassObjectsStep",
      "kind": "query",
      "operationId": "countClassObjects",
      "inputType": "CountClassObjectsInput",
      "description": "Count objects in one Bmob class without returning records.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "counted",
          "field": "counted",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "CountClassObjectsInput identifies one existing Bmob class.",
        "properties": {
          "className": {
            "description": "ClassName is the case-sensitive Bmob class name from the app's Data console.",
            "type": "string"
          }
        },
        "required": [
          "className"
        ],
        "type": "object"
      }
    }
  ]
}
