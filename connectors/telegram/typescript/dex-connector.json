      "branches": [
        {
          "id": "sent",
          "field": "sent",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "uncertain",
          "field": "uncertain",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ]
    },
    {
