{
  "connectorId": "jotform",
  "releaseTag": "connectors/jotform/go/v0.2.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-jotform",
    "version": "0.2.0"
  },
  "factories": [
    {
      "name": "newListFormsStep",
      "kind": "query",
      "operationId": "listForms",
      "inputType": "ListFormsInput",
      "description": "List one page of form titles and IDs without submission answers.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "listed",
          "field": "listed",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "ListFormsInput selects a zero-based page of at most 100 forms.",
        "properties": {
          "limit": {
            "description": "Limit is the maximum form count; zero defaults to 20.",
            "type": "integer"
          },
          "offset": {
            "description": "Offset is the zero-based form offset; zero starts the first page.",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "newGetSubmissionStep",
      "kind": "query",
      "operationId": "getSubmission",
      "inputType": "GetSubmissionInput",
      "description": "Read one submission's ID, form ID, status, and creation timestamp; answers are intentionally excluded.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "notFound",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GetSubmissionInput selects one numeric Jotform submission ID.",
        "properties": {
          "submissionId": {
            "description": "SubmissionID is the numeric ID from Jotform's submission URL or API.",
            "type": "string"
          }
        },
        "required": [
          "submissionId"
        ],
        "type": "object"
      }
    }
  ]
}
