{
  "connectorId": "odoo",
  "releaseTag": "connectors/odoo/go/v0.1.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-odoo",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newSearchPartnersStep",
      "kind": "query",
      "operationId": "searchPartners",
      "inputType": "SearchPartnersInput",
      "description": "Search company partners by Odoo ilike name pattern and return only IDs and names.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "SearchPartnersInput selects an Odoo ilike name pattern and result bound.",
        "properties": {
          "limit": {
            "description": "Limit is one through one hundred; zero uses twenty.",
            "type": "integer"
          },
          "namePattern": {
            "description": "NamePattern is an Odoo ilike pattern such as %Acme%.",
            "type": "string"
          }
        },
        "required": [
          "namePattern"
        ],
        "type": "object"
      }
    }
  ]
}
