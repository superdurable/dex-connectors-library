{
  "connectorId": "algolia",
  "releaseTag": "connectors/algolia/go/v0.2.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-algolia",
    "version": "0.1.1"
  },
  "factories": [
    {
      "name": "newSearchStep",
      "kind": "query",
      "operationId": "search",
      "inputType": "SearchInput",
      "description": "Search one Algolia index by query phrase.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "searched",
          "field": "searched",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "SearchInput selects an index and search phrase.",
        "properties": {
          "hitsPerPage": {
            "description": "HitsPerPage bounds the returned hits; zero uses Algolia's default.",
            "type": "integer"
          },
          "indexName": {
            "description": "IndexName names the Algolia index.",
            "type": "string"
          },
          "query": {
            "description": "Query is the search phrase; blank matches all records.",
            "type": "string"
          }
        },
        "required": [
          "indexName",
          "query"
        ],
        "type": "object"
      }
    },
    {
      "name": "newSaveObjectStep",
      "kind": "mutation",
      "operationId": "saveObject",
      "inputType": "SaveObjectInput",
      "description": "Replace one record by stable objectID; Algolia queues indexing asynchronously.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "saved",
          "field": "saved",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "SaveObjectInput replaces a record's complete set of string attributes.",
        "properties": {
          "attributes": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Attributes are absolute non-secret record values; omitted old attributes are removed.",
            "type": [
              "object",
              "null"
            ]
          },
          "indexName": {
            "description": "IndexName names the target index.",
            "type": "string"
          },
          "objectID": {
            "description": "ObjectID identifies the record to replace on retries.",
            "type": "string"
          }
        },
        "required": [
          "attributes",
          "indexName",
          "objectID"
        ],
        "type": "object"
      }
    }
  ]
}
