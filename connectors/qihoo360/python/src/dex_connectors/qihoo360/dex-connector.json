{
  "connectorId": "qihoo360",
  "releaseTag": "connectors/qihoo360/go/v0.1.0",
  "package": {
    "ecosystem": "pypi",
    "name": "dex-connector-qihoo360",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "new_generate_text_step",
      "kind": "query",
      "operationId": "generateText",
      "inputType": "GenerateTextInput",
      "description": "Generate one nonstreaming, text-only response from a 360 智脑 model.",
      "fields": {
        "stepType": "step_type",
        "annotations": "annotations",
        "connectionName": "connection_name",
        "resultAttribute": "result_attribute"
      },
      "branches": [
        {
          "id": "generated",
          "field": "generated",
          "optional": false
        },
        {
          "id": "truncated",
          "field": "truncated",
          "optional": true
        },
        {
          "id": "blocked",
          "field": "blocked",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "provider_rejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalid_response",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GenerateTextInput requests one text answer. MaxOutputTokens defaults to 1024 when zero.",
        "properties": {
          "maxOutputTokens": {
            "description": "MaxOutputTokens limits generated tokens to 1 through 4096; zero uses 1024.",
            "type": "integer"
          },
          "prompt": {
            "description": "Prompt is a nonempty user message of at most 64 KiB.",
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ],
        "type": "object"
      }
    }
  ]
}
