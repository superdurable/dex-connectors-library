{
  "connectorId": "geovisearth",
  "releaseTag": "connectors/geovisearth/go/v0.1.1",
  "package": {
    "ecosystem": "maven",
    "name": "io.superdurable:dex-connector-geovisearth",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newGetCurrentWeatherStep",
      "kind": "query",
      "operationId": "getCurrentWeather",
      "inputType": "GetCurrentWeatherInput",
      "description": "Get current weather observations for one Chinese area code or coordinate.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "fetched",
          "field": "fetched",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GetCurrentWeatherInput selects an official area code or longitude,latitude coordinate.",
        "properties": {
          "location": {
            "description": "Location is a GEOVIS Earth area code such as WTX_CH101300201, or longitude,latitude in decimal degrees.",
            "type": "string"
          }
        },
        "required": [
          "location"
        ],
        "type": "object"
      }
    }
  ]
}
