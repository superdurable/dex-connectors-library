{
  "connectorId": "facebook-pages",
  "releaseTag": "connectors/meta/facebook-pages/go/v0.1.0",
  "package": {
    "ecosystem": "pypi",
    "name": "dex-connector-meta-facebook-pages",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "new_list_posts_step",
      "kind": "query",
      "operationId": "listPosts",
      "inputType": "ListPostsInput",
      "description": "Read one page of Page feed post IDs, messages, timestamps, and permalinks.",
      "fields": {
        "stepType": "step_type",
        "annotations": "annotations",
        "connectionName": "connection_name",
        "resultAttribute": "result_attribute"
      },
      "branches": [
        {
          "id": "listed",
          "field": "listed",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "not_found",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "provider_rejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalid_response",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "ListPostsInput selects a Facebook Page and an optional feed cursor.",
        "properties": {
          "after": {
            "description": "After is Meta's opaque cursor from a prior page; blank starts at the first page.",
            "type": "string"
          },
          "pageId": {
            "description": "PageID is the numeric Page ID from Meta Business Suite.",
            "type": "string"
          }
        },
        "required": [
          "pageId"
        ],
        "type": "object"
      }
    },
    {
      "name": "new_get_post_step",
      "kind": "query",
      "operationId": "getPost",
      "inputType": "GetPostInput",
      "description": "Read one Page post's ID, message, timestamp, and permalink.",
      "fields": {
        "stepType": "step_type",
        "annotations": "annotations",
        "connectionName": "connection_name",
        "resultAttribute": "result_attribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "not_found",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "provider_rejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalid_response",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GetPostInput selects one post ID from listPosts or a Page event.",
        "properties": {
          "postId": {
            "description": "PostID is a numeric or PageID_PostID Graph API identifier.",
            "type": "string"
          }
        },
        "required": [
          "postId"
        ],
        "type": "object"
      }
    },
    {
      "name": "new_publish_text_post_step",
      "kind": "mutation",
      "operationId": "publishTextPost",
      "inputType": "PublishTextPostInput",
      "description": "Publish a plain-text post to a Facebook Page feed.",
      "fields": {
        "stepType": "step_type",
        "annotations": "annotations",
        "connectionName": "connection_name",
        "resultAttribute": "result_attribute"
      },
      "branches": [
        {
          "id": "published",
          "field": "published",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "provider_rejected",
          "optional": true
        },
        {
          "id": "uncertain",
          "field": "uncertain",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "PublishTextPostInput selects the Page and text to publish.",
        "properties": {
          "message": {
            "description": "Message is nonempty UTF-8 text for the public Page feed.",
            "type": "string"
          },
          "pageId": {
            "description": "PageID is the numeric Page ID from Meta Business Suite.",
            "type": "string"
          }
        },
        "required": [
          "message",
          "pageId"
        ],
        "type": "object"
      }
    }
  ]
}
