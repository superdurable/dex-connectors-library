{
  "connectorId": "segment",
  "releaseTag": "connectors/twilio/segment/go/v0.1.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-twilio-segment",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newGetSourceStep",
      "kind": "query",
      "operationId": "getSource",
      "inputType": "GetSourceInput",
      "description": "Return one Source's ID, slug, and optional display name without write keys.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "notFound",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GetSourceInput selects a Source by its non-secret Segment ID.",
        "properties": {
          "sourceId": {
            "description": "SourceID is the opaque ID returned by the Segment Public API.",
            "type": "string"
          }
        },
        "required": [
          "sourceId"
        ],
        "type": "object"
      }
    }
  ]
}
