{
  "connectorId": "twilio-messaging",
  "releaseTag": "connectors/twilio/messaging/go/v0.23.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-twilio-messaging",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newSendMessageStep",
      "kind": "mutation",
      "operationId": "sendMessage",
      "inputType": "SendMessageInput",
      "description": "Send one SMS, MMS, or WhatsApp message from a Twilio number or Messaging Service to one recipient; synchronous durability makes the single-dispatch checkpoint visible to retries because Twilio provides no message idempotency key.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "accepted",
          "field": "accepted",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "uncertain",
          "field": "uncertain",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "SendMessageInput describes one message to one recipient.",
        "properties": {
          "body": {
            "description": "Body is the message text, at most 1600 characters. It may be empty only when MediaURLs is set.",
            "type": "string"
          },
          "mediaUrls": {
            "description": "MediaURLs lists at most 10 public HTTPS URLs that Twilio fetches and attaches, which makes an SMS an MMS.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "sender": {
            "description": "Sender overrides the connection's defaultSender with an E.164 number, a whatsapp: address, or an MG Messaging Service SID. Blank uses defaultSender.",
            "type": "string"
          },
          "to": {
            "description": "To is the recipient: an E.164 number such as +14155550100, or whatsapp:+14155550100.",
            "type": "string"
          }
        },
        "required": [
          "to"
        ],
        "type": "object"
      }
    },
    {
      "name": "newGetMessageStep",
      "kind": "query",
      "operationId": "getMessage",
      "inputType": "GetMessageInput",
      "description": "Read one message by SID, including its delivery status and Twilio error code.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "notFound",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GetMessageInput identifies one message.",
        "properties": {
          "messageSid": {
            "description": "MessageSID is the SM or MM message SID returned by sendMessage.",
            "type": "string"
          }
        },
        "required": [
          "messageSid"
        ],
        "type": "object"
      }
    }
  ]
}
