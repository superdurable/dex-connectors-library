{
  "connectorId": "posthog",
  "releaseTag": "connectors/posthog/go/v0.1.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-posthog",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newCaptureEventStep",
      "kind": "mutation",
      "operationId": "captureEvent",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "accepted",
          "field": "accepted",
          "optional": false
        },
        {
          "id": "quotaLimited",
          "field": "quotaLimited",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ]
    },
    {
      "name": "newListInsightsStep",
      "kind": "query",
      "operationId": "listInsights",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "listed",
          "field": "listed",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ]
    }
  ]
}
