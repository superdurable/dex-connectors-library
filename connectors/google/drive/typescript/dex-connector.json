{
  "connectorId": "google-drive",
  "releaseTag": "connectors/google/drive/go/v0.24.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-google-drive",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newSearchFilesStep",
      "kind": "query",
      "operationId": "searchFiles",
      "inputType": "SearchFilesInput",
      "description": "Find non-trashed files by exact or prefix name, MIME type, and parent folder, newest first, one bounded page at a time.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "notFound",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "SearchFilesInput filters one page of non-trashed Drive files. Every set filter must match; an input without filters lists recent files.",
        "properties": {
          "mimeType": {
            "description": "MimeType restricts results to one Drive MIME type, such as application/vnd.google-apps.spreadsheet; blank matches any type.",
            "type": "string"
          },
          "name": {
            "description": "Name is the file name to match; blank matches any name.",
            "type": "string"
          },
          "nameMatch": {
            "description": "NameMatch selects exact or prefix-term matching; blank means exact.",
            "enum": [
              "contains",
              "exact"
            ],
            "type": "string"
          },
          "pageSize": {
            "description": "PageSize is the page size from 1 to 100; zero uses the connection's searchPageSize.",
            "type": "integer"
          },
          "pageToken": {
            "description": "PageToken continues a previous search with its NextPageToken; blank starts at the first page.",
            "type": "string"
          },
          "parentFolderId": {
            "description": "ParentFolderID restricts results to direct children of one folder ID, or root for the My Drive root; blank searches every visible folder.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "newGetFileStep",
      "kind": "query",
      "operationId": "getFile",
      "inputType": "GetFileInput",
      "description": "Read the full metadata of one file by its Drive file ID.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "notFound",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GetFileInput identifies one Drive file.",
        "properties": {
          "fileId": {
            "description": "FileID is the Drive file ID, such as a SearchFiles result ID.",
            "type": "string"
          }
        },
        "required": [
          "fileId"
        ],
        "type": "object"
      }
    },
    {
      "name": "newReadFileTextStep",
      "kind": "query",
      "operationId": "readFileText",
      "inputType": "ReadFileTextInput",
      "description": "Read bounded UTF-8 text by exporting a Google Doc, Sheet, or Slides file or downloading a small text file.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "read",
          "field": "read",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "notFound",
          "optional": true
        },
        {
          "id": "unsupportedContent",
          "field": "unsupportedContent",
          "optional": true
        },
        {
          "id": "tooLarge",
          "field": "tooLarge",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "ReadFileTextInput identifies the Drive file whose text is read.",
        "properties": {
          "fileId": {
            "description": "FileID is the Drive file ID, such as a SearchFiles result ID.",
            "type": "string"
          }
        },
        "required": [
          "fileId"
        ],
        "type": "object"
      }
    },
    {
      "name": "newUploadFileStep",
      "kind": "mutation",
      "operationId": "uploadFile",
      "inputType": "UploadFileInput",
      "description": "Create one file from text or bytes in an optional parent folder. Sync durability makes the single-dispatch heartbeat fence visible to retries, while the app property supports read-back of ambiguous uploads.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "uploaded",
          "field": "uploaded",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "uncertain",
          "field": "uncertain",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "UploadFileInput describes one new Drive file. Set at most one of TextContent and ByteContent; leaving both empty creates an empty file.",
        "properties": {
          "byteContent": {
            "contentEncoding": "base64",
            "description": "ByteContent is binary content, encoded as base64 in JSON.",
            "type": "string"
          },
          "mimeType": {
            "description": "MimeType is the content's lowercase MIME type, such as text/plain or text/csv. Google Workspace types are rejected, so Drive never converts the upload.",
            "type": "string"
          },
          "name": {
            "description": "Name is the new file's title; it must not be blank.",
            "type": "string"
          },
          "parentFolderId": {
            "description": "ParentFolderID is the destination folder ID; blank creates the file in the My Drive root.",
            "type": "string"
          },
          "textContent": {
            "description": "TextContent is UTF-8 text content.",
            "type": "string"
          }
        },
        "required": [
          "mimeType",
          "name"
        ],
        "type": "object"
      }
    }
  ]
}
