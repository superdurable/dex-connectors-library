{
  "name": "@superdurable/connector-google-drive",
  "version": "0.2.1",
  "license": "MIT",
  "description": "Dex Google Drive connector for TypeScript, with file created, updated, and trashed Triggers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superdurable/dex-connectors-library.git",
    "directory": "connectors/google/drive/typescript"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mock": {
      "import": {
        "types": "./dist/mock/index.d.ts",
        "default": "./dist/mock/index.js"
      },
      "require": {
        "types": "./dist/mock/index.d.cts",
        "default": "./dist/mock/index.cjs"
      }
    },
    "./dex-connector.json": "./dex-connector.json"
  },
  "files": [
    "dist",
    "dex-connector.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/mock/index.ts --format esm,cjs --dts --clean",
    "typecheck": "npm run build && tsc --noEmit",
    "lint": "eslint src test examples",
    "test": "npm run build && vitest run test/*.test.ts",
    "test:integration": "npm run build && vitest run examples/text-copy/integration.test.ts examples/file-intake/integration.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "example:worker": "npm run build && tsx examples/text-copy/main.ts",
    "example:start": "npm run build && tsx examples/text-copy/start.ts",
    "example:intake": "npm run build && tsx examples/file-intake/main.ts"
  },
  "dependencies": {
    "@superdurable/connectors-sdk": "0.12.0",
    "@superdurable/dex": ">=1.45.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.1"
  }
}
