{
  "connectorId": "fanruan",
  "releaseTag": "connectors/fanruan/go/v0.1.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-fanruan",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newListAppsPageStep",
      "kind": "query",
      "operationId": "listAppsPage",
      "inputType": "ListAppsPageInput",
      "description": "List one page of applications authorized by the API Key.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "listed",
          "field": "listed",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "ListAppsPageInput selects one page of authorized applications.",
        "properties": {
          "limit": {
            "description": "Limit is the page size from 1 through 100; zero uses 100.",
            "type": "integer"
          },
          "skip": {
            "description": "Skip omits this many earlier applications, starting at zero.",
            "type": "integer"
          }
        },
        "required": [
