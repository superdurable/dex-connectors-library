{
  "realm": "dex-oauth2-http",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 60,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "credentials": [{ "type": "password", "value": "${DEX_TEST_USER_PASSWORD}", "temporary": false }]
    }
  ],
  "clients": [
    {
      "clientId": "dex-oauth2-http-test",
      "name": "Dex OAuth 2.0 HTTP connector test client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${DEX_TEST_CLIENT_SECRET}",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://dex-test.invalid/callback"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["profile", "email", "roles", "web-origins"]
    }
  ]
}
