{
  "connectorId": "llm",
  "releaseTag": "connectors/superdurable/llm/go/v0.25.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-superdurable-llm",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newGenerateTextStep",
      "kind": "query",
      "operationId": "generateText",
      "inputType": "GenerateTextRequest",
      "description": "Generate text or JSON Schema structured output with a model of the connection's provider through that provider's stateless text generation API.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "generated",
          "field": "generated",
          "optional": false
        },
        {
          "id": "truncated",
          "field": "truncated",
          "optional": true
        },
        {
          "id": "blocked",
          "field": "blocked",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "$defs": {
          "textgenMessage": {
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "text"
            ],
            "type": "object"
          },
          "textgenStructuredOutput": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "schema": {
                "additionalProperties": {},
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "schema"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "GenerateTextRequest is the provider-neutral generateText input. Its Model is the provider's own model ID, or blank for the connection's model.",
        "properties": {
          "instructions": {
            "type": "string"
          },
          "maxOutputTokens": {
            "type": "integer"
          },
          "messages": {
            "items": {
              "$ref": "#/$defs/textgenMessage"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "model": {
            "type": "string"
          },
          "reasoningEffort": {
            "type": "string"
          },
          "structuredOutput": {
            "$ref": "#/$defs/textgenStructuredOutput"
          },
          "temperature": {
            "type": "number"
          }
        },
        "required": [
          "messages"
        ],
        "type": "object"
      }
    }
  ]
}
