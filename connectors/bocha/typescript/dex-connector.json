{
  "connectorId": "bocha",
  "releaseTag": "connectors/bocha/go/v0.1.1",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-bocha",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newSearchWebStep",
      "kind": "query",
      "operationId": "searchWeb",
      "inputType": "SearchWebInput",
      "description": "Search public web pages and return up to five titles, URLs, and snippets.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "SearchWebInput supplies a public web search query.",
        "properties": {
          "query": {
            "description": "Query is a nonblank search phrase of at most 256 Unicode characters.",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      }
    }
  ]
}
