{
  "connectorId": "basecamp",
  "releaseTag": "connectors/basecamp/go/v0.1.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-basecamp",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newListAccountsStep",
      "kind": "query",
      "operationId": "listAccounts",
      "inputType": "ListAccountsInput",
      "description": "Return a locally bounded page of Basecamp account IDs and names.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "listed",
          "field": "listed",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "ListAccountsInput selects a locally bounded page of authorized accounts.",
        "properties": {
          "limit": {
            "description": "Limit is the maximum account count; zero uses 100.",
            "type": "integer"
          },
          "offset": {
            "description": "Offset is the zero-based number of accounts to skip.",
            "type": "integer"
          }
        },
        "required": [
          "offset"
        ],
        "type": "object"
      }
    }
  ]
