{
  "connectorId": "pandadoc",
  "releaseTag": "connectors/pandadoc/go/v0.1.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-pandadoc",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newGetDocumentStep",
      "kind": "query",
      "operationId": "getDocument",
      "inputType": "GetDocumentInput",
      "description": "Read one document's ID, name, and status without recipients, fields, tokens, or pricing.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "notFound",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GetDocumentInput selects a document by its non-secret ID.",
        "properties": {
          "documentId": {
            "description": "DocumentID is the ID returned by PandaDoc when a document is created.",
            "type": "string"
          }
        },
        "required": [
          "documentId"
        ],
        "type": "object"
      }
    }
  ]
}
