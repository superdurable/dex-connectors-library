{
  "connectorId": "mixpanel",
  "releaseTag": "connectors/mixpanel/go/v0.2.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-mixpanel",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newTrackEventStep",
      "kind": "mutation",
      "operationId": "trackEvent",
      "inputType": "TrackEventInput",
      "description": "Import one event with stable time, distinct_id, and a derived $insert_id.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "imported",
          "field": "imported",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "TrackEventInput identifies one stable event across Dex retries.",
        "properties": {
          "distinctID": {
            "description": "DistinctID identifies the associated user and must remain stable across retries.",
            "type": "string"
          },
          "event": {
            "description": "Event is the Mixpanel event name.",
            "type": "string"
          },
          "properties": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Properties contains optional non-secret string properties.",
            "type": "object"
          },
          "time": {
            "description": "Time is the event's Unix timestamp in seconds and must remain stable across retries.",
            "type": "integer"
          }
        },
        "required": [
          "distinctID",
          "event",
          "time"
        ],
        "type": "object"
      }
    },
    {
      "name": "newExportEventsStep",
      "kind": "query",
      "operationId": "exportEvents",
      "inputType": "ExportEventsInput",
      "description": "Export a bounded date range of raw events without arbitrary properties.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "exported",
          "field": "exported",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "ExportEventsInput selects a bounded raw event export.",
        "properties": {
          "fromDate": {
            "description": "FromDate is the inclusive YYYY-MM-DD start date.",
            "type": "string"
          },
          "limit": {
            "description": "Limit is the maximum number of raw events, from 1 through 100.",
            "type": "integer"
          },
          "toDate": {
            "description": "ToDate is the inclusive YYYY-MM-DD end date.",
            "type": "string"
          }
        },
        "required": [
          "fromDate",
          "limit",
          "toDate"
        ],
        "type": "object"
      }
    }
  ]
}
