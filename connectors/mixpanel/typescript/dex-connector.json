{
  "connectorId": "mixpanel",
  "releaseTag": "connectors/mixpanel/go/v0.2.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-mixpanel",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newTrackEventStep",
      "kind": "mutation",
      "operationId": "trackEvent",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "imported",
          "field": "imported",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ]
    },
    {
      "name": "newExportEventsStep",
      "kind": "query",
      "operationId": "exportEvents",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "exported",
          "field": "exported",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ]
    }
  ]
}
