{
  "connectorId": "gitlab",
  "releaseTag": "connectors/gitlab/go/v0.2.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-gitlab",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newGetProjectStep",
      "kind": "query",
      "operationId": "getProject",
      "inputType": "GetProjectInput",
      "description": "Read one GitLab project by numeric ID or namespace path.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "notFound",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GetProjectInput identifies a project by numeric ID or namespace path.",
        "properties": {
          "projectId": {
            "description": "ProjectID is a numeric ID or namespace path, such as meridian/web.",
            "type": "string"
          }
        },
        "required": [
          "projectId"
        ],
        "type": "object"
      }
    },
    {
      "name": "newListIssuesStep",
      "kind": "query",
      "operationId": "listIssues",
      "inputType": "ListIssuesInput",
      "description": "List the first page of issues for a GitLab project.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "listed",
          "field": "listed",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "notFound",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "ListIssuesInput identifies the project whose issues are listed.",
        "properties": {
          "projectId": {
            "description": "ProjectID is a numeric ID or namespace path.",
            "type": "string"
          }
        },
        "required": [
          "projectId"
        ],
        "type": "object"
      }
    },
    {
      "name": "newUpdateIssueLabelsStep",
      "kind": "mutation",
      "operationId": "updateIssueLabels",
      "inputType": "UpdateIssueLabelsInput",
      "description": "Replace one GitLab issue's complete label set; repeating the request is safe.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "updated",
          "field": "updated",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "notFound",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "UpdateIssueLabelsInput replaces every label on one issue; an empty list clears them.",
        "properties": {
          "issueIid": {
            "description": "IssueIID is the positive project-local issue number.",
            "type": "integer"
          },
          "labels": {
            "description": "Labels is the desired complete label set; empty clears all labels.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "projectId": {
            "description": "ProjectID is a numeric ID or namespace path.",
            "type": "string"
          }
        },
        "required": [
          "issueIid",
          "labels",
          "projectId"
        ],
        "type": "object"
      }
    }
  ]
}
