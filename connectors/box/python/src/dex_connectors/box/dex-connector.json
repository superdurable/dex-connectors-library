{
  "connectorId": "box",
  "releaseTag": "connectors/box/go/v0.1.0",
  "package": {
    "ecosystem": "pypi",
    "name": "dex-connector-box",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "new_download_file_step",
      "kind": "query",
      "operationId": "downloadFile",
      "inputType": "DownloadFileInput",
      "description": "Download one bounded Box file by its ID and return Base64 content.",
      "fields": {
        "stepType": "step_type",
        "annotations": "annotations",
        "connectionName": "connection_name",
        "resultAttribute": "result_attribute"
      },
      "branches": [
        {
          "id": "downloaded",
          "field": "downloaded",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "not_found",
          "optional": true
        },
        {
          "id": "tooLarge",
          "field": "too_large",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "provider_rejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalid_response",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "DownloadFileInput selects one Box file by its numeric ID.",
        "properties": {
          "fileId": {
            "description": "FileID appears in Box Web's /files/<ID> URL.",
            "type": "string"
          }
        },
        "required": [
          "fileId"
        ],
        "type": "object"
      }
    },
    {
      "name": "new_upload_file_step",
      "kind": "mutation",
      "operationId": "uploadFile",
      "inputType": "UploadFileInput",
      "description": "Replace an existing Box file's current content with bounded Base64 bytes, skipping an already identical file.",
      "fields": {
        "stepType": "step_type",
        "annotations": "annotations",
        "connectionName": "connection_name",
        "resultAttribute": "result_attribute"
      },
      "branches": [
        {
          "id": "uploaded",
          "field": "uploaded",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "not_found",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "provider_rejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalid_response",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "UploadFileInput replaces an existing Box file's current content.",
        "properties": {
          "contentBase64": {
            "description": "ContentBase64 holds the complete replacement bytes.",
            "type": "string"
          },
          "fileId": {
            "description": "FileID appears in Box Web's /files/<ID> URL.",
            "type": "string"
          }
        },
        "required": [
          "contentBase64",
          "fileId"
        ],
        "type": "object"
      }
    }
  ]
}
