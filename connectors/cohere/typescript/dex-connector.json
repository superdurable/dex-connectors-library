{
  "connectorId": "cohere",
  "releaseTag": "connectors/cohere/go/v0.3.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-cohere",
    "version": "0.2.0"
  },
  "factories": [
    {
      "name": "newChatStep",
      "kind": "query",
      "operationId": "chat",
      "inputType": "ChatInput",
      "description": "Generate one text reply from a Cohere v2 chat model.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "answered",
          "field": "answered",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "$defs": {
          "ChatMessage": {
            "additionalProperties": false,
            "description": "ChatMessage is one text message in chronological order.",
            "properties": {
              "content": {
                "description": "Content is the nonempty message text.",
                "type": "string"
              },
              "role": {
                "description": "Role is system, user, or assistant.",
                "type": "string"
              }
            },
            "required": [
              "content",
              "role"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "ChatInput selects a model and a text conversation for one generation.",
        "properties": {
          "max_tokens": {
            "description": "MaxTokens limits generated output tokens; zero uses the model default.",
            "type": "integer"
          },
          "messages": {
            "description": "Messages are chronological text messages.",
            "items": {
              "$ref": "#/$defs/ChatMessage"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "model": {
            "description": "Model is a Cohere Chat model ID.",
            "type": "string"
          }
        },
        "required": [
          "messages",
          "model"
        ],
        "type": "object"
      }
    },
    {
      "name": "newEmbedStep",
      "kind": "query",
      "operationId": "embed",
      "inputType": "EmbedInput",
      "description": "Generate float embeddings for text with Cohere v2.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "embedded",
          "field": "embedded",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "EmbedInput asks Cohere to embed up to 96 texts as float vectors.",
        "properties": {
          "input_type": {
            "description": "InputType is search_document, search_query, classification, or clustering.",
            "type": "string"
          },
          "model": {
            "description": "Model is a Cohere Embed model ID.",
            "type": "string"
          },
          "texts": {
            "description": "Texts are text inputs; the response has one vector per text.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "input_type",
          "model",
          "texts"
        ],
        "type": "object"
      }
    },
    {
      "name": "newRerankStep",
      "kind": "query",
      "operationId": "rerank",
      "inputType": "RerankInput",
      "description": "Rank text documents by relevance to one query through Cohere v2.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "ranked",
          "field": "ranked",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "RerankInput asks Cohere to rank documents for a text query.",
        "properties": {
          "documents": {
            "description": "Documents are text passages to rank, in original order.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "model": {
            "description": "Model is a Cohere Rerank model ID.",
            "type": "string"
          },
          "query": {
            "description": "Query is the relevance question.",
            "type": "string"
          },
          "top_n": {
            "description": "TopN limits returned results; zero returns all.",
            "type": "integer"
          }
        },
        "required": [
          "documents",
          "model",
          "query"
        ],
        "type": "object"
      }
    }
  ]
}
