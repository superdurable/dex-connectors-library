{
  "name": "@superdurable/connector-paypal",
  "version": "0.1.0",
  "description": "PayPal connector for Dex TypeScript applications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superdurable/dex-connectors-library.git",
    "directory": "connectors/paypal/typescript"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dex-connector.json": "./dex-connector.json"
  },
  "files": [
    "dist",
    "dex-connector.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test examples",
    "test": "vitest run --exclude 'test/integration/**'",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "example:resource-read": "tsx examples/resource-read/main.ts",
    "example:resource-read:start": "tsx examples/resource-read/start.ts",
    "test:integration": "npm run build && vitest run test/integration"
  },
  "dependencies": {
    "@superdurable/connectors-sdk": "0.1.0",
    "@superdurable/dex": ">=1.28.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.1"
  }
}
