{
  "name": "@superdurable/connector-postgresql",
  "version": "0.1.0",
  "license": "MIT",
  "description": "PostgreSQL connector for Dex TypeScript applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superdurable/dex-connectors-library.git",
    "directory": "connectors/postgresql/typescript"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js"
    }
  },
  "files": [
    "dist",
    "dex-connector.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/mock.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test examples",
    "test": "vitest run --exclude test/integration.test.ts --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration.test.ts",
    "test:dex": "vitest run test/integration/dex.integration.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "example:refund": "npm run build && tsx examples/record-refund/main.ts",
    "example:refund:start": "npm run build && tsx examples/record-refund/start.ts"
  },
  "dependencies": {
    "@superdurable/connectors-sdk": "0.1.0",
    "@superdurable/dex": ">=1.28.0",
    "pg": "^8.16.0",
    "pg-cursor": "^2.22.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/pg-cursor": "^2.7.2",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
