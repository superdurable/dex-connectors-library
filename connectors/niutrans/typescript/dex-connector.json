{
  "connectorId": "niutrans",
  "releaseTag": "connectors/niutrans/go/v0.1.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-niutrans",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newTranslateTextStep",
      "kind": "query",
      "operationId": "translateText",
      "inputType": "TranslateTextInput",
      "description": "Translate up to 1000 Unicode characters from one language to another.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "translated",
          "field": "translated",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "TranslateTextInput supplies bounded source text and language codes.",
        "properties": {
          "from": {
            "description": "From is the NiuTrans source language code, such as zh or auto.",
            "type": "string"
          },
          "text": {
            "description": "Text is the source content, limited to 1000 Unicode characters.",
            "type": "string"
          },
          "to": {
            "description": "To is the NiuTrans target language code, such as en.",
            "type": "string"
          }
        },
        "required": [
          "from",
          "text",
          "to"
        ],
        "type": "object"
      }
    }
  ]
}
