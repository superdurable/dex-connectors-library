        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "missing",
          "field": "missing",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GetItemInput identifies a table row by all of its S, N, or B key attributes.",
        "properties": {
          "consistentRead": {
            "type": "boolean"
          },
          "key": {
            "additionalProperties": {},
            "type": [
              "object",
              "null"
            ]
          },
          "tableName": {
            "type": "string"
          }
        },
        "required": [
          "consistentRead",
          "key",
          "tableName"
        ],
        "type": "object"
      }
    }
  ]
