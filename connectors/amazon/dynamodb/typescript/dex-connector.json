{
  "connectorId": "amazon-dynamodb",
  "releaseTag": "connectors/amazon/dynamodb/go/v0.1.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-amazon-dynamodb",
    "version": "0.1.0"
