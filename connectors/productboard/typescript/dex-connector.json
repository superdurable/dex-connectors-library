{
  "connectorId": "productboard",
  "releaseTag": "connectors/productboard/go/v0.1.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-productboard",
    "version": "0.1.0"
  },
  "factories": [
    {
      "name": "newListFeaturesStep",
      "kind": "query",
      "operationId": "listFeatures",
      "inputType": "ListFeaturesInput",
      "description": "List one page of feature IDs and names, with an opaque next-page cursor.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "listed",
          "field": "listed",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "ListFeaturesInput selects a page by its opaque, non-secret cursor.",
        "properties": {
          "pageCursor": {
            "description": "PageCursor is blank for the first page or a previous NextCursor value.",
            "type": "string"
          }
        },
        "required": [
          "pageCursor"
        ],
        "type": "object"
      }
    }
  ]
}
