{
  "connectorId": "insightly",
  "releaseTag": "connectors/insightly/go/v0.2.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-insightly",
    "version": "0.2.0"
  },
  "factories": [
    {
      "name": "newListContactsStep",
      "kind": "query",
      "operationId": "listContacts",
      "inputType": "ListContactsInput",
      "description": "List contact IDs, names, and email addresses with a bounded page size and offset.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "listed",
          "field": "listed",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "ListContactsInput selects a bounded Insightly contact page.",
        "properties": {
          "skip": {
            "description": "Skip is the nonnegative number of contacts to omit before this page; zero starts at the first contact.",
            "type": "integer"
          },
          "top": {
            "description": "Top is the maximum page size, from 1 to 500 records.",
            "type": "integer"
          }
        },
        "required": [
          "top"
        ],
        "type": "object"
      }
    },
    {
      "name": "newGetContactStep",
      "kind": "query",
      "operationId": "getContact",
      "inputType": "GetContactInput",
      "description": "Read a contact's ID, names, and email address by ID.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "notFound",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GetContactInput selects one Insightly contact by its numeric ID.",
        "properties": {
          "contactId": {
            "description": "ContactID is the decimal ID shown in Insightly and returned by its API.",
            "type": "string"
          }
        },
        "required": [
          "contactId"
        ],
        "type": "object"
      }
    }
  ]
}
