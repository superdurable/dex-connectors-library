{
  "connectorId": "contentful",
  "releaseTag": "connectors/contentful/go/v0.2.0",
  "package": {
    "ecosystem": "npm",
    "name": "@superdurable/connector-contentful",
    "version": "0.1.1"
  },
  "factories": [
    {
      "name": "newGetEntryStep",
      "kind": "query",
      "operationId": "getEntry",
      "inputType": "GetEntryInput",
      "description": "Get one published Contentful entry.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "found",
          "field": "found",
          "optional": false
        },
        {
          "id": "notFound",
          "field": "notFound",
          "optional": true
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "GetEntryInput identifies one published entry.",
        "properties": {
          "entryId": {
            "description": "EntryID is the published entry ID.",
            "type": "string"
          },
          "environmentId": {
            "description": "EnvironmentID is the environment ID, usually master.",
            "type": "string"
          },
          "spaceId": {
            "description": "SpaceID is the Contentful space ID.",
            "type": "string"
          }
        },
        "required": [
          "entryId",
          "environmentId",
          "spaceId"
        ],
        "type": "object"
      }
    },
    {
      "name": "newListEntriesStep",
      "kind": "query",
      "operationId": "listEntries",
      "inputType": "ListEntriesInput",
      "description": "List one page of published entries in a space and environment.",
      "fields": {
        "stepType": "stepType",
        "annotations": "annotations",
        "connectionName": "connectionName",
        "resultAttribute": "resultAttribute"
      },
      "branches": [
        {
          "id": "listed",
          "field": "listed",
          "optional": false
        },
        {
          "id": "providerRejected",
          "field": "providerRejected",
          "optional": true
        },
        {
          "id": "invalidResponse",
          "field": "invalidResponse",
          "optional": true
        },
        {
          "id": "defect",
          "field": "defect",
          "optional": true
        }
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "ListEntriesInput selects one page of published entries.",
        "properties": {
          "environmentId": {
            "description": "EnvironmentID is the environment ID.",
            "type": "string"
          },
          "limit": {
            "description": "Limit caps entries, from 1 through 1000; zero uses the provider default.",
            "type": "integer"
          },
          "skip": {
            "description": "Skip is the zero-based offset.",
            "type": "integer"
          },
          "spaceId": {
            "description": "SpaceID is the Contentful space ID.",
            "type": "string"
          }
        },
        "required": [
          "environmentId",
          "spaceId"
        ],
        "type": "object"
      }
    }
  ]
}
