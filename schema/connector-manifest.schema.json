{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superdurable.dev/schemas/connector-manifest-v1alpha1.json",
  "title": "Dex Connector Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "connectors.dex.dev/v1alpha1" },
    "kind": { "const": "Connector" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "displayName", "description", "company", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "company": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "codegen", "configuration", "auth", "operations"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "languages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "python": { "$ref": "#/$defs/pythonLanguage" },
            "typescript": { "$ref": "#/$defs/typescriptLanguage" }
          }
        },
        "codegen": {
          "type": "object",
          "additionalProperties": false,
          "required": ["go"],
          "properties": {
            "go": {
              "type": "object",
              "additionalProperties": false,
              "required": ["package"],
              "properties": { "package": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" } }
            }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fields"],
          "properties": {
            "fields": {
              "type": "array",
              "items": { "$ref": "#/$defs/configField" }
            }
          }
        },
        "auth": {
          "description": "Either one authentication model (type, connectionKind, fields, guide, oauth2) or several methods, of which each connection selects one.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "$ref": "#/$defs/authType" },
            "connectionKind": { "type": "string" },
            "fields": {
              "description": "Credential fields. With methods, connectorctl replaces this list with the union of the method fields, each optional.",
              "type": "array",
              "items": { "$ref": "#/$defs/authField" }
            },
            "guide": { "$ref": "#/$defs/authorizationGuide" },
            "oauth2": { "$ref": "#/$defs/oauth2" },
            "clientCredentials": { "$ref": "#/$defs/clientCredentials" },
            "serviceAccount": { "$ref": "#/$defs/serviceAccount" },
            "refreshable": {
              "description": "The connector renews expiring credentials. Required when a method maps a refresh token or declares clientCredentials or serviceAccount.jwtBearer.",
              "type": "boolean"
            },
            "methodLabel": {
              "description": "Singular noun, such as Provider, that setup UI uses for a method.",
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
            },
            "defaultMethod": { "$ref": "#/$defs/authMethodID" },
            "methods": {
              "description": "Method IDs are unique, and the credential fields that several methods share use the same goName and type.",
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/authMethod" }
            }
          },
          "oneOf": [
            {
              "required": ["type"],
              "$ref": "#/$defs/credentialAuthRules",
              "not": {
                "anyOf": [
                  { "required": ["methods"] },
                  { "required": ["defaultMethod"] },
                  { "required": ["methodLabel"] }
                ]
              }
            },
            {
              "required": ["methods", "defaultMethod"],
              "not": {
                "anyOf": [
                  { "required": ["type"] },
                  { "required": ["connectionKind"] },
                  { "required": ["guide"] },
                  { "required": ["oauth2"] },
                  { "required": ["clientCredentials"] },
                  { "required": ["serviceAccount"] }
                ]
              }
            }
          ]
        },
        "studio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["setup"],
          "properties": {
            "setup": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entrypoint", "hostApiRange", "backendCapabilities", "mockScenarios", "icon"],
              "properties": {
                "entrypoint": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.html$" },
                "hostApiRange": { "type": "string", "minLength": 1 },
                "backendCapabilities": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$" }
                },
                "mockScenarios": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
                },
                "icon": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:png|svg)$" }
              }
            },
            "units": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/studioUnit" }
            },
            "commands": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/studioCommand" }
            }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/operation" }
        },
        "triggers": {
          "type": "array",
          "items": { "$ref": "#/$defs/trigger" }
        }
      }
    }
  },
  "$defs": {
    "pythonLanguage": {
      "type": "object", "additionalProperties": false, "required": ["version"],
      "properties": {
        "version": { "type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "package": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
      }
    },
    "typescriptLanguage": {
      "type": "object", "additionalProperties": false, "required": ["version"],
      "properties": {
        "version": { "type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "package": { "type": "string", "pattern": "^@[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$" }
      }
    },
    "studioCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability", "request"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" },
        "capability": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$" },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "url", "credential"],
          "properties": {
            "method": { "const": "GET" },
            "url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "credential": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "scheme"],
              "properties": {
                "field": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
                "scheme": { "enum": ["bearer", "header"] },
                "header": { "$ref": "#/$defs/studioCommandHeaderName" }
              },
              "if": { "properties": { "scheme": { "const": "header" } }, "required": ["scheme"] },
              "then": { "required": ["header"] },
              "else": { "not": { "required": ["header"] } }
            },
            "fixedQuery": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "fixedHeaders": {
              "description": "Non-secret headers sent with every request. Names are unique ignoring case and treating _ as -, and cannot repeat the credential header.",
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/studioCommandHeaderName" },
              "additionalProperties": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^[\\x21-\\x7E](?:[\\x20-\\x7E]*[\\x21-\\x7E])?$"
              }
            },
            "parameters": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "location", "target"],
                "properties": {
                  "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
                  "location": { "enum": ["path", "query"] },
                  "target": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "studioCommandHeaderName": {
      "description": "An RFC 7230 token. Authorization, Accept, hop-by-hop, routing, cookie, method-override, Proxy-*, and X-Forwarded-* names are reserved, ignoring case and treating _ as -.",
      "type": "string",
      "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$",
      "not": {
        "pattern": "^(?:(?:[Aa][Cc][Cc][Ee][Pp][Tt]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Cc][Oo][Nn][Nn][Ee][Cc][Tt][Ii][Oo][Nn]|[Cc][Oo][Nn][Tt][Ee][Nn][Tt][-_][Ll][Ee][Nn][Gg][Tt][Hh]|[Cc][Oo][Oo][Kk][Ii][Ee]|[Ff][Oo][Rr][Ww][Aa][Rr][Dd][Ee][Dd]|[Hh][Oo][Ss][Tt]|[Kk][Ee][Ee][Pp][-_][Aa][Ll][Ii][Vv][Ee]|[Oo][Rr][Ii][Gg][Ii][Nn]|[Rr][Ee][Ff][Ee][Rr][Ee][Rr]|[Ss][Ee][Tt][-_][Cc][Oo][Oo][Kk][Ii][Ee]|[Tt][Ee]|[Tt][Rr][Aa][Ii][Ll][Ee][Rr]|[Tt][Rr][Aa][Nn][Ss][Ff][Ee][Rr][-_][Ee][Nn][Cc][Oo][Dd][Ii][Nn][Gg]|[Uu][Pp][Gg][Rr][Aa][Dd][Ee]|[Xx][-_][Hh][Tt][Tt][Pp][-_][Mm][Ee][Tt][Hh][Oo][Dd]|[Xx][-_][Hh][Tt][Tt][Pp][-_][Mm][Ee][Tt][Hh][Oo][Dd][-_][Oo][Vv][Ee][Rr][Rr][Ii][Dd][Ee]|[Xx][-_][Mm][Ee][Tt][Hh][Oo][Dd][-_][Oo][Vv][Ee][Rr][Rr][Ii][Dd][Ee])$|[Pp][Rr][Oo][Xx][Yy][-_]|[Xx][-_][Ff][Oo][Rr][Ww][Aa][Rr][Dd][Ee][Dd][-_])"
      }
    },
    "studioUnitPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "goName", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" },
        "goName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "type": { "enum": ["string", "stringList", "integer", "number", "boolean"] }
      }
    },
    "studioUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "goName", "description", "outputs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" },
        "goName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "description": { "type": "string", "minLength": 1 },
        "backendCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$" }
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/studioUnitPort" }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/studioUnitPort" }
        }
      }
    },
    "settingReference": {
      "description": "Names a spec.configuration field, or a field of the same auth method's configuration, whose value the connection owner enters.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fromSetting"],
      "properties": {
        "fromSetting": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" }
      }
    },
    "oauthEndpoint": {
      "description": "A fixed HTTPS URL, or a reference to a required url configuration field. The consumer decides which schemes a setting value may use.",
      "oneOf": [
        { "type": "string", "format": "uri", "pattern": "^https://" },
        { "$ref": "#/$defs/settingReference" }
      ]
    },
    "oauthScopes": {
      "description": "A fixed scope list, or a reference to a required stringList configuration field.",
      "oneOf": [
        { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        { "$ref": "#/$defs/settingReference" }
      ]
    },
    "oauthCredentialMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential", "source"],
      "properties": {
        "credential": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
        "source": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*(\\.[a-z][A-Za-z0-9_]*)*$" }
      }
    },
    "oauthCredentialDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential", "endpoint", "source"],
      "properties": {
        "credential": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
        "endpoint": { "$ref": "#/$defs/oauthEndpoint" },
        "source": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*(\\.[a-z][A-Za-z0-9_]*)*$" },
        "verifiedBy": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*(\\.[a-z][A-Za-z0-9_]*)*$" }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "goName", "eventType", "configurationType", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" },
        "goName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "eventType": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "configurationType": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "authType": { "enum": ["none", "apiKey", "oauth2", "serviceAccount"] },
    "authMethodID": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "authorizationGuide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startURL", "steps"],
      "properties": {
        "startURL": { "type": "string", "format": "uri", "pattern": "^https://" },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\S" } }
      }
    },
    "credentialAuthRules": {
      "description": "Credential auth declares connectionKind, fields, and a guide; none declares neither; only oauth2 declares oauth2 metadata, only apiKey clientCredentials, and only serviceAccount serviceAccount metadata.",
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "none" } }, "required": ["type"] },
          "then": {
            "properties": { "fields": { "maxItems": 0 } },
            "not": { "required": ["guide"] }
          },
          "else": {
            "required": ["connectionKind", "fields", "guide"],
            "properties": { "connectionKind": { "minLength": 1 }, "fields": { "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "oauth2" } }, "required": ["type"] },
          "then": { "required": ["oauth2"] },
          "else": { "not": { "required": ["oauth2"] } }
        },
        {
          "if": { "properties": { "type": { "const": "apiKey" } }, "required": ["type"] },
          "else": { "not": { "required": ["clientCredentials"] } }
        },
        {
          "if": { "properties": { "type": { "const": "serviceAccount" } }, "required": ["type"] },
          "else": { "not": { "required": ["serviceAccount"] } }
        }
      ]
    },
    "authMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "description", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/authMethodID" },
        "displayName": { "type": "string", "pattern": "\\S" },
        "description": { "type": "string", "pattern": "\\S" },
        "recommended": { "description": "At most one method is recommended.", "type": "boolean" },
        "type": { "$ref": "#/$defs/authType" },
        "connectionKind": { "type": "string" },
        "fields": {
          "description": "Name auth_method and Go name AuthMethodID are reserved for the selected method.",
          "type": "array",
          "items": { "$ref": "#/$defs/authField" }
        },
        "configuration": {
          "description": "Non-secret fields used only while this method is selected. Names are unique across spec.configuration and every method's configuration and differ from every credential field name.",
          "type": "object",
          "additionalProperties": false,
          "required": ["fields"],
          "properties": {
            "fields": { "type": "array", "items": { "$ref": "#/$defs/methodConfigurationField" } }
          }
        },
        "guide": { "$ref": "#/$defs/authorizationGuide" },
        "oauth2": { "$ref": "#/$defs/oauth2" },
        "clientCredentials": { "$ref": "#/$defs/clientCredentials" },
        "serviceAccount": { "$ref": "#/$defs/serviceAccount" }
      },
      "$ref": "#/$defs/credentialAuthRules"
    },
    "oauth2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorizationEndpoint", "tokenEndpoint", "scopes", "pkce"],
      "properties": {
        "protocol": { "enum": ["oauth2", "oidc"] },
        "authorizationEndpoint": { "$ref": "#/$defs/oauthEndpoint" },
        "tokenEndpoint": { "$ref": "#/$defs/oauthEndpoint" },
        "authorizationParameters": {
          "type": "object",
          "propertyNames": {
            "pattern": "\\S",
            "not": { "enum": ["client_id", "redirect_uri", "response_type", "scope", "state", "code_challenge", "code_challenge_method"] }
          },
          "additionalProperties": { "type": "string", "pattern": "\\S" }
        },
        "clientIDCredential": { "description": "A non-secret credential field.", "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
        "clientSecretCredential": { "description": "A secretString credential field.", "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
        "scopes": { "$ref": "#/$defs/oauthScopes" },
        "userScopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "credentialMappings": {
          "type": "array",
          "items": { "$ref": "#/$defs/oauthCredentialMapping" }
        },
        "credentialDerivations": {
          "type": "array",
          "items": { "$ref": "#/$defs/oauthCredentialDerivation" }
        },
        "pkce": { "type": "boolean" },
        "tokenEndpointAuthMethod": { "$ref": "#/$defs/tokenEndpointAuthMethod" },
        "tokenRequestEncoding": { "$ref": "#/$defs/tokenRequestEncoding" },
        "refresh": { "$ref": "#/$defs/oauthRefresh" },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuer", "discoveryEndpoint", "userInfoEndpoint", "nonceRequired"],
          "properties": {
            "issuer": { "$ref": "#/$defs/oauthEndpoint" },
            "discoveryEndpoint": { "$ref": "#/$defs/oauthEndpoint" },
            "userInfoEndpoint": { "$ref": "#/$defs/oauthEndpoint" },
            "nonceRequired": { "const": true }
          }
        }
      },
      "dependentRequired": {
        "clientIDCredential": ["clientSecretCredential"],
        "clientSecretCredential": ["clientIDCredential"]
      },
      "allOf": [
        {
          "if": { "properties": { "protocol": { "const": "oidc" } }, "required": ["protocol"] },
          "then": { "required": ["oidc"] }
        },
        {
          "if": { "properties": { "protocol": { "const": "oauth2" } }, "required": ["protocol"] },
          "then": { "not": { "required": ["oidc"] } }
        }
      ]
    },
    "tokenEndpointAuthMethod": {
      "description": "How token requests present the client; client_secret_post when absent. A value source, such as {fromSetting: <enum setting>}, resolves to one of the two methods. A connection without a client secret sends only client_id.",
      "oneOf": [
        { "enum": ["client_secret_post", "client_secret_basic"] },
        { "allOf": [{ "$ref": "#/$defs/valueSource" }, { "type": "object", "not": { "required": ["template"] } }] }
      ]
    },
    "tokenRequestEncoding": {
      "description": "The token request body; form when absent.",
      "enum": ["form", "json"]
    },
    "terminalErrorCodes": {
      "description": "OAuth error codes, in a response below HTTP 500, after which the stored grant can never succeed again.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "\\S" }
    },
    "missingExpiry": {
      "description": "The expiry of a token whose response has no expires_in: keep stores it without an expiry; lifetime sets one.",
      "oneOf": [
        { "const": "keep" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["lifetime"],
          "properties": { "lifetime": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$" } }
        }
      ]
    },
    "additionalTokenParameters": {
      "description": "Fixed, non-secret parameters added to every token request; none replaces a grant or client parameter.",
      "type": "object",
      "propertyNames": {
        "pattern": "\\S",
        "not": { "enum": ["grant_type", "refresh_token", "client_id", "client_secret", "assertion", "client_assertion", "client_assertion_type"] }
      },
      "additionalProperties": { "type": "string", "pattern": "\\S" }
    },
    "credentialMappings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/oauthCredentialMapping" }
    },
    "valueSource": {
      "description": "A literal string, or exactly one source: a credential field, a setting of the method, a member of the JSON key credential, or a template whose {name} placeholders name credential fields or settings. values translates the value of a field, setting, or key member; its key \"\" translates a blank value.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "fromCredential": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
            "fromSetting": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
            "fromKey": { "type": "string", "minLength": 1 },
            "template": { "type": "string", "pattern": "^https://[^/{}]+/.*\\{[a-z][A-Za-z0-9_]*\\}" },
            "values": { "type": "object", "additionalProperties": { "type": "string", "pattern": "\\S" } }
          },
          "oneOf": [
            { "required": ["fromCredential"] },
            { "required": ["fromSetting"] },
            { "required": ["fromKey"] },
            { "required": ["template"], "not": { "required": ["values"] } }
          ]
        }
      ]
    },
    "oauthRefresh": {
      "description": "How a host refreshes the access token. tokenEndpoint, tokenEndpointAuthMethod, tokenRequestEncoding, the client credentials, and credentialMappings apply to refresh requests and responses too; a value that a refresh response omits keeps the stored one.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "terminalErrorCodes": { "$ref": "#/$defs/terminalErrorCodes", "description": "invalid_grant when absent." },
        "missingExpiry": { "$ref": "#/$defs/missingExpiry", "description": "keep when absent." },
        "additionalParameters": { "$ref": "#/$defs/additionalTokenParameters" },
        "grants": {
          "description": "The refresh tokens of a method that stores several. When absent, the credential mapped from refresh_token with the method's credentialMappings.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["refreshTokenCredential", "credentialMappings"],
            "properties": {
              "refreshTokenCredential": { "description": "A secretString credential field; blank skips the grant.", "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
              "credentialMappings": { "$ref": "#/$defs/credentialMappings" },
              "grantedScopes": { "description": "The declared scope set the granted scopes must contain; scopes when absent.", "enum": ["scopes", "userScopes"] }
            }
          }
        }
      }
    },
    "clientCredentials": {
      "description": "How a host mints an apiKey method's access token with the OAuth client credentials grant.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenEndpoint", "clientIDCredential", "clientSecretCredential", "credentialMappings"],
      "properties": {
        "tokenEndpoint": { "$ref": "#/$defs/valueSource" },
        "tokenEndpointAuthMethod": { "$ref": "#/$defs/tokenEndpointAuthMethod" },
        "tokenRequestEncoding": { "$ref": "#/$defs/tokenRequestEncoding" },
        "clientIDCredential": { "description": "A non-secret credential field.", "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
        "clientSecretCredential": { "description": "A secretString credential field.", "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
        "scopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "credentialMappings": { "$ref": "#/$defs/credentialMappings" },
        "terminalErrorCodes": { "$ref": "#/$defs/terminalErrorCodes", "description": "invalid_client when absent." },
        "missingExpiry": { "$ref": "#/$defs/missingExpiry", "description": "keep when absent." },
        "additionalParameters": { "$ref": "#/$defs/additionalTokenParameters" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jwtBearer"],
      "properties": {
        "jwtBearer": {
          "description": "How a host mints the access token with an RS256 JWT bearer assertion signed by the stored private key.",
          "type": "object",
          "additionalProperties": false,
          "required": ["privateKey", "issuer", "audience", "tokenEndpoint", "lifetime", "credentialMappings"],
          "properties": {
            "keyCredential": { "description": "A secretString credential field holding the JSON key that fromKey sources read.", "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
            "privateKey": { "$ref": "#/$defs/valueSource", "description": "The PEM RSA private key." },
            "issuer": { "$ref": "#/$defs/valueSource" },
            "subject": { "$ref": "#/$defs/valueSource" },
            "audience": { "$ref": "#/$defs/valueSource" },
            "tokenEndpoint": { "$ref": "#/$defs/valueSource" },
            "scopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "lifetime": { "description": "How long after iat the assertion expires.", "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$" },
            "credentialMappings": { "$ref": "#/$defs/credentialMappings" },
            "credentialCopies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["credential", "fromCredential"],
                "properties": {
                  "credential": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
                  "fromCredential": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" }
                }
              }
            },
            "terminalErrorCodes": { "$ref": "#/$defs/terminalErrorCodes", "description": "invalid_grant when absent." },
            "missingExpiry": { "$ref": "#/$defs/missingExpiry", "description": "keep when absent." }
          }
        }
      }
    },
    "fieldBase": {
      "type": "object",
      "required": ["name", "goName", "type", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
        "goName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "type": { "type": "string" },
        "description": { "type": "string", "pattern": "\\S" },
        "required": { "type": "boolean" },
        "default": {},
        "enum": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      },
      "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
      "then": { "required": ["enum"] }
    },
    "nonSecretFieldType": {
      "properties": { "type": { "enum": ["string", "url", "integer", "boolean", "duration", "stringList", "stringMap", "enum"] } }
    },
    "fieldStudioUnit": {
      "description": "Renders the field with a Studio unit once the connection is saved. unit names a spec.studio.units id; port names one of its outputs whose type equals the field type.",
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "port"],
      "properties": {
        "unit": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" },
        "port": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" }
      }
    },
    "configField": {
      "description": "A spec.configuration field. Only these fields may declare studioUnit.",
      "allOf": [{ "$ref": "#/$defs/fieldBase" }, { "$ref": "#/$defs/nonSecretFieldType" }],
      "properties": { "studioUnit": { "$ref": "#/$defs/fieldStudioUnit" } },
      "unevaluatedProperties": false
    },
    "methodConfigurationField": {
      "description": "A non-secret auth method configuration field. required means required while the method is selected; generated Config never requires it.",
      "allOf": [{ "$ref": "#/$defs/fieldBase" }, { "$ref": "#/$defs/nonSecretFieldType" }],
      "unevaluatedProperties": false
    },
    "authField": {
      "allOf": [
        { "$ref": "#/$defs/fieldBase" },
        { "properties": { "type": { "enum": ["string", "url", "integer", "boolean", "duration", "stringList", "stringMap", "enum", "secretString"] } } }
      ],
      "unevaluatedProperties": false
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "goName", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" },
        "goName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "description": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" }
      },
      "if": { "properties": { "id": { "const": "defect" } }, "required": ["id"] },
      "then": { "required": ["optional"], "properties": { "optional": { "const": true } } }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executeMethodTimeout", "durability"],
      "properties": {
        "executeMethodTimeout": { "type": "string", "minLength": 1 },
        "heartbeatTimeout": { "type": "string", "minLength": 1 },
        "durability": { "enum": ["sync", "async"] },
        "dispatchFence": { "type": "boolean", "description": "Requires sync Execute durability; the operation uses a heartbeat dispatch fence." },
        "retry": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["initialInterval", "backoffCoefficient", "maximumInterval", "totalDuration"],
          "properties": {
            "initialInterval": { "type": "string", "minLength": 1 },
            "backoffCoefficient": { "type": "number", "minimum": 1 },
            "maximumInterval": { "type": "string", "minLength": 1 },
            "maximumAttempts": { "type": "integer", "minimum": 0 },
            "totalDuration": { "type": "string", "minLength": 1 },
            "reason": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "explanation"],
              "properties": {
                "kind": { "enum": ["billedOperation", "personWaiting", "duplicateWriteRisk"] },
                "explanation": { "type": "string", "pattern": "\\S" }
              }
            }
          }
        }
      },
      "if": { "properties": { "dispatchFence": { "const": true } }, "required": ["dispatchFence"] },
      "then": { "properties": { "durability": { "const": "sync" } } }
    },
    "mockFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": { "enum": ["VALIDATION", "AUTHENTICATION", "AUTHORIZATION", "NOT_FOUND", "CONFLICT", "RATE_LIMIT", "QUOTA_EXHAUSTED", "AVAILABILITY", "PROVIDER_REJECTION", "TRANSPORT", "RESPONSE_TOO_LARGE", "PROTOCOL", "LOCAL_DEFECT"] },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "operationMock": {
      "description": "One maintained outcome of the generated mock package: a branch mock with output, pages, or failure; a retry; or an uncertain mutation outcome.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" },
        "branch": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" },
        "description": { "type": "string", "minLength": 1 },
        "output": {},
        "pages": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "failure": { "$ref": "#/$defs/mockFailure" },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["failure"],
          "properties": {
            "failure": { "$ref": "#/$defs/mockFailure" },
            "after": { "type": "string" }
          }
        },
        "uncertain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["failure"],
          "properties": {
            "output": {},
            "failure": { "$ref": "#/$defs/mockFailure" }
          }
        },
        "default": { "type": "boolean" }
      },
      "oneOf": [
        { "required": ["retry"], "not": { "anyOf": [{ "required": ["branch"] }, { "required": ["output"] }, { "required": ["pages"] }, { "required": ["failure"] }, { "required": ["uncertain"] }, { "required": ["default"] }] } },
        { "required": ["uncertain"], "not": { "anyOf": [{ "required": ["output"] }, { "required": ["pages"] }, { "required": ["failure"] }, { "required": ["retry"] }, { "required": ["default"] }] } },
        { "required": ["branch"], "anyOf": [{ "required": ["output"] }, { "required": ["pages"] }, { "required": ["failure"] }], "not": { "anyOf": [{ "required": ["retry"] }, { "required": ["uncertain"] }] } }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "goName", "inputType", "outputType", "kind", "description", "idempotency", "branches", "execution"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" },
        "goName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "inputType": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "outputType": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "kind": { "enum": ["query", "mutation"] },
        "description": { "type": "string", "minLength": 1 },
        "idempotency": { "enum": ["none", "required"] },
        "branches": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/branch" } },
        "progress": { "type": "array", "uniqueItems": true, "items": { "enum": ["structured", "text"] } },
        "authorization": { "enum": ["none", "required"] },
        "execution": { "$ref": "#/$defs/execution" },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputField", "nextField"],
          "properties": {
            "inputField": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
            "nextField": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" }
          }
        },
        "mocks": { "type": "array", "items": { "$ref": "#/$defs/operationMock" } },
        "mockChecks": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "requestFunction": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
            "answer": {
              "type": "object",
              "additionalProperties": false,
              "required": ["branch", "function"],
              "properties": {
                "branch": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" },
                "function": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }
              }
            }
          }
        }
      },
      "dependentSchemas": {
        "mockChecks": {
          "required": ["mocks"],
          "properties": { "mocks": { "minItems": 1 } }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "mutation" } } },
          "then": { "properties": { "idempotency": { "const": "required" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "query" } } },
          "then": { "properties": { "idempotency": { "const": "none" } } }
        }
      ]
    }
  }
}
