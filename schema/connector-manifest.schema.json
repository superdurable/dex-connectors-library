{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superdurable.dev/schemas/connector-manifest-v1alpha1.json",
  "title": "Dex Connector Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "connectors.dex.dev/v1alpha1" },
    "kind": { "const": "Connector" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "displayName", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "codegen", "configuration", "auth", "operations"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "codegen": {
          "type": "object",
          "additionalProperties": false,
          "required": ["go"],
          "properties": {
            "go": {
              "type": "object",
              "additionalProperties": false,
              "required": ["package"],
              "properties": { "package": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" } }
            }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fields"],
          "properties": {
            "fields": {
              "type": "array",
              "items": { "$ref": "#/$defs/configField" }
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "fields"],
          "properties": {
            "type": { "enum": ["none", "apiKey", "oauth2"] },
            "connectionKind": { "type": "string" },
            "fields": {
              "type": "array",
              "items": { "$ref": "#/$defs/authField" }
            },
            "oauth2": {
              "type": "object",
              "additionalProperties": false,
              "required": ["authorizationEndpoint", "tokenEndpoint", "scopes", "pkce"],
              "properties": {
                "protocol": { "enum": ["oauth2", "oidc"] },
                "authorizationEndpoint": { "type": "string", "format": "uri" },
                "tokenEndpoint": { "type": "string", "format": "uri" },
                "scopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "userScopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "credentialMappings": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/oauthCredentialMapping" }
                },
                "pkce": { "type": "boolean" },
                "oidc": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["issuer", "discoveryEndpoint", "userInfoEndpoint", "nonceRequired"],
                  "properties": {
                    "issuer": { "type": "string", "format": "uri" },
                    "discoveryEndpoint": { "type": "string", "format": "uri" },
                    "userInfoEndpoint": { "type": "string", "format": "uri" },
                    "nonceRequired": { "const": true }
                  }
                }
              },
              "allOf": [
                {
                  "if": { "properties": { "protocol": { "const": "oidc" } }, "required": ["protocol"] },
                  "then": { "required": ["oidc"] }
                },
                {
                  "if": { "properties": { "protocol": { "const": "oauth2" } }, "required": ["protocol"] },
                  "then": { "not": { "required": ["oidc"] } }
                }
              ]
            }
          }
        },
        "studio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["setup"],
          "properties": {
            "setup": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entrypoint", "hostApiRange", "backendCapabilities", "mockScenarios", "icon"],
              "properties": {
                "entrypoint": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.html$" },
                "hostApiRange": { "type": "string", "minLength": 1 },
                "backendCapabilities": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$" }
                },
                "mockScenarios": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
                },
                "icon": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:png|svg)$" }
              }
            }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/operation" }
        },
        "triggers": {
          "type": "array",
          "items": { "$ref": "#/$defs/trigger" }
        }
      }
    }
  },
  "$defs": {
    "oauthCredentialMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential", "source"],
      "properties": {
        "credential": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
        "source": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*(\\.[a-z][A-Za-z0-9_]*)*$" }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "goName", "eventType", "configurationType", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" },
        "goName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "eventType": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "configurationType": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "fieldBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "goName", "type", "description", "required"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "goName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "type": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "default": {},
        "enum": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "configField": {
      "allOf": [
        { "$ref": "#/$defs/fieldBase" },
        { "properties": { "type": { "enum": ["string", "url", "integer", "boolean", "duration", "stringList", "stringMap", "enum"] } } }
      ]
    },
    "authField": {
      "allOf": [
        { "$ref": "#/$defs/fieldBase" },
        { "properties": { "type": { "enum": ["string", "url", "integer", "boolean", "duration", "stringList", "stringMap", "enum", "secretString"] } } }
      ]
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "goName", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" },
        "goName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executeMethodTimeout", "durability", "retry"],
      "properties": {
        "executeMethodTimeout": { "type": "string", "minLength": 1 },
        "heartbeatTimeout": { "type": "string", "minLength": 1 },
        "durability": { "enum": ["sync", "async"] },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initialInterval", "backoffCoefficient", "maximumInterval", "maximumAttempts", "totalDuration"],
          "properties": {
            "initialInterval": { "type": "string", "minLength": 1 },
            "backoffCoefficient": { "type": "number", "minimum": 1 },
            "maximumInterval": { "type": "string", "minLength": 1 },
            "maximumAttempts": { "type": "integer", "minimum": 1 },
            "totalDuration": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "goName", "inputType", "outputType", "kind", "description", "idempotency", "branches", "execution"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" },
        "goName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "inputType": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "outputType": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "kind": { "enum": ["query", "mutation"] },
        "description": { "type": "string", "minLength": 1 },
        "idempotency": { "enum": ["none", "required"] },
        "branches": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/branch" } },
        "progress": { "type": "array", "uniqueItems": true, "items": { "enum": ["structured", "text"] } },
        "authorization": { "enum": ["none", "required"] },
        "execution": { "$ref": "#/$defs/execution" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "mutation" } } },
          "then": { "properties": { "idempotency": { "const": "required" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "query" } } },
          "then": { "properties": { "idempotency": { "const": "none" } } }
        }
      ]
    }
  }
}
