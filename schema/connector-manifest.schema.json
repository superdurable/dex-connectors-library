{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superdurable.dev/schemas/connector-manifest-v1alpha1.json",
  "title": "Dex Connector Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "connectors.dex.dev/v1alpha1" },
    "kind": { "const": "Connector" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "displayName", "version", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "displayName": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+([+-].*)?$" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "auth", "operations"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "fields"],
          "properties": {
            "type": { "enum": ["none", "apiKey", "oauth2"] },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "required", "sensitive"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "required": { "type": "boolean" },
                  "sensitive": { "type": "boolean" }
                }
              }
            }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "description", "idempotency"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" },
              "kind": { "enum": ["query", "mutation"] },
              "description": { "type": "string", "minLength": 1 },
              "idempotency": { "enum": ["none", "required", "provider"] }
            }
          }
        }
      }
    }
  }
}
