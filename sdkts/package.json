{
  "name": "@superdurable/connectors-sdk",
  "version": "0.1.0",
  "description": "Provider-neutral TypeScript contracts for Dex connectors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superdurable/dex-connectors-library.git",
    "directory": "sdkts"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providerhttp": {
      "types": "./dist/providerhttp/index.d.ts",
      "import": "./dist/providerhttp/index.js"
    },
    "./projectconfig": {
      "types": "./dist/projectconfig/index.d.ts",
      "import": "./dist/projectconfig/index.js"
    },
    "./connectormock": {
      "types": "./dist/connectormock/index.d.ts",
      "import": "./dist/connectormock/index.js"
    },
    "./oauthtoken": {
      "types": "./dist/oauthtoken/index.d.ts",
      "import": "./dist/oauthtoken/index.js"
    },
    "./singledispatch": {
      "types": "./dist/singledispatch/index.d.ts",
      "import": "./dist/singledispatch/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsup src/index.ts src/providerhttp/index.ts src/projectconfig/index.ts src/connectormock/index.ts src/oauthtoken/index.ts src/singledispatch/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:package": "node test/pack_smoke.mjs",
    "test:integration": "npm run build && node test/integ/step_flows.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:package"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@superdurable/dex": ">=1.28.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
